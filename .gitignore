# dotenv files
.env

# Dont checkin archived changes, but keep the directory for git to track
openspec/changes/archive/

# Rust / Cargo
# Cargo.lock IS committed: trainer-rs builds a deployed application, not a
# library, so reproducible dependency resolution is wanted.
trainer-rs/target/
**/*.rs.bk

# GitNexus index
.gitnexus/

# Python (the fixture de-identifier)
__pycache__/
*.pyc

# Editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/
.idea
*.swp

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# Others
~$*
*~
