@page "/activity-type"
@page "/activity-type/{Id:int}"
@inject IActivityTypeService ActivityTypeService
@inject IActivityService ActivityService
@inject NavigationManager Navigation

<PageTitle>@(IsEditMode ? "Edit Activity Type" : "Add Activity Type")</PageTitle>

<div class="header-area">
    <h1 class="mb-0">@(IsEditMode ? "Edit Activity Type" : "Add Activity Type")</h1>
</div>

<div class="container mt-4">
    <EditForm Model="@activityType" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        
        <div class="mb-3">
            <label class="form-label">Name</label>
            <InputText @bind-Value="activityType.Name" class="form-control" />
            <ValidationMessage For="@(() => activityType.Name)" />
        </div>

        <div class="mb-3">
            <label class="form-label">Net Benefit</label>
            <div class="btn-group mt-2" role="group">
                <button type="button"
                        class="btn @(activityType.NetBenefit == NetBenefit.Positive ? "btn-success" : "btn-outline-success")"
                        @onclick="() => ToggleNetBenefit(NetBenefit.Positive)">
                    Positive
                </button>
                <button type="button"
                        class="btn @(activityType.NetBenefit == NetBenefit.Neutral ? "btn-secondary" : "btn-outline-secondary")"
                        @onclick="() => ToggleNetBenefit(NetBenefit.Neutral)">
                    Neutral
                </button>
                <button type="button"
                        class="btn @(activityType.NetBenefit == NetBenefit.Negative ? "btn-danger" : "btn-outline-danger")"
                        @onclick="() => ToggleNetBenefit(NetBenefit.Negative)">
                    Negative
                </button>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Decimal Places</label>
            @if (ShowReinterpretWarning)
            {
                <div class="alert alert-warning py-2 small mb-2" role="alert">
                    Changing this will reinterpret all @_activityCount existing
                    @(_activityCount == 1 ? "activity" : "activities") of this type
                    (e.g. a stored amount of 125 shows as 125 at 0 places but 1.25 at 2 places).
                </div>
            }
            <InputSelect @bind-Value="activityType.DecimalPlaces" class="form-select">
                @for (var places = 0; places <= MaxDecimalPlaces; places++)
                {
                    <option value="@places">@places</option>
                }
            </InputSelect>
        </div>

        <div class="mb-3">
            <label class="form-label">Daily Amount</label>
            <DecimalAmountInput @bind-Value="activityType.DailyAmount" DecimalPlaces="activityType.DecimalPlaces" />
        </div>

        <div class="mb-3">
            <label class="form-label">Weekly Amount</label>
            <DecimalAmountInput @bind-Value="activityType.WeeklyAmount" DecimalPlaces="activityType.DecimalPlaces" />
        </div>

        <div class="mb-3">
            <label class="form-label">Unit of Measurement</label>
            <InputText @bind-Value="activityType.Unit" class="form-control" placeholder="e.g., cups, reps, ounces" />
        </div>

        <div class="mb-3">
            <div class="form-check">
                <InputCheckbox @bind-Value="activityType.IsPrivate" class="form-check-input" id="isPrivate" />
                <label class="form-check-label" for="isPrivate">Private (hidden from home, activities, and calendar unless searched by name)</label>
            </div>
        </div>

        <div class="mb-3">
            <button type="submit" class="btn btn-primary">@(IsEditMode ? "Update" : "Add")</button>
            <button type="button" class="btn btn-secondary ms-2" @onclick="Cancel">Cancel</button>
        </div>
    </EditForm>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private const int MaxDecimalPlaces = 3;

    private ActivityType activityType = new();
    private bool IsEditMode => Id > 0;
    private string returnUrl = "/activity";
    private int _savedDecimalPlaces;
    private int _activityCount;

    private bool ShowReinterpretWarning =>
        DecimalPlacesWarning.ShouldWarn(_savedDecimalPlaces, activityType.DecimalPlaces, _activityCount);

    protected override async Task OnInitializedAsync()
    {
        // Parse return URL from query parameters
        var uri = new Uri(Navigation.Uri);
        if (!string.IsNullOrEmpty(uri.Query))
        {
            var queryString = uri.Query.TrimStart('?');
            var queryParams = queryString.Split('&')
                .Select(p => p.Split('='))
                .Where(p => p.Length == 2)
                .GroupBy(p => Uri.UnescapeDataString(p[0]), p => Uri.UnescapeDataString(p[1]))
                .ToDictionary(g => g.Key, g => g.First());
            
            if (queryParams.TryGetValue("returnUrl", out var url))
            {
                returnUrl = url;
            }
        }
        
        if (IsEditMode)
        {
            var existingType = await ActivityTypeService.GetByIdAsync(Id);
            if (existingType != null)
            {
                activityType = existingType;
            }

            _savedDecimalPlaces = activityType.DecimalPlaces;
            _activityCount = (await ActivityService.GetByActivityTypeIdAsync(Id)).Count;
        }
    }

    private void ToggleNetBenefit(NetBenefit benefit)
    {
        activityType.NetBenefit = benefit;
    }

    private string GetNavigationPath(string path)
    {
        var baseUri = Navigation.BaseUri.TrimEnd('/');
        var normalizedPath = path.TrimStart('/');
        return $"{baseUri}/{normalizedPath}";
    }

    private async Task HandleSubmit()
    {
        if (IsEditMode)
        {
            await ActivityTypeService.UpdateAsync(activityType);
        }
        else
        {
            await ActivityTypeService.AddAsync(activityType);
        }
        
        Navigation.NavigateTo(GetNavigationPath(returnUrl));
    }

    private void Cancel()
    {
        Navigation.NavigateTo(GetNavigationPath(returnUrl));
    }
}

