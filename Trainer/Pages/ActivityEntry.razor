@page "/activity"
@page "/activity/{Id:int}"
@inject IActivityService ActivityService
@inject IActivityTypeService ActivityTypeService
@inject IKnownLocationService KnownLocationService
@inject IActiveActivityService ActiveActivityService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>@(IsEditMode ? "Edit Activity" : "Add Activity")</PageTitle>

<div class="header-area">
    <h1 class="mb-0">@(IsEditMode ? "Edit Activity" : "Add Activity")</h1>
</div>

<div class="container mt-4">
    <EditForm Model="@activity" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        
        <div class="mb-3">
            <label class="form-label">Type</label>
            <div class="input-group">
                <InputSelect @bind-Value="ActivityTypeId" class="form-select">
                    <option value="0">Select an activity type...</option>
                    @foreach (var type in activityTypes)
                    {
                        <option value="@type.Id">@type.Name</option>
                    }
                </InputSelect>
                <button type="button" class="btn btn-outline-secondary" @onclick="HandleActivityTypeButtonClick">
                    @if (activity.ActivityTypeId == 0)
                    {
                        <span>+</span>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 0 0 0 0-.708l-3-3zm.646 6.061L9.793 2.5 3.293 9H3.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.207l6.5-6.5zm-7.468 7.468A.5.5 0 0 1 6 13.5V13h-.5a.5.5 0 0 1-.5-.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.5-.5V10h-.5a.499.499 0 0 1-.175-.032l-.179.178a.5.5 0 0 0-.11.168l-2 5a.5.5 0 0 0 .65.65l5-2a.5.5 0 0 0 .168-.11l.178-.178z"/>
                        </svg>
                    }
                </button>
            </div>
            <ValidationMessage For="@(() => activity.ActivityTypeId)" />
        </div>

        <div class="mb-3">
            <label class="form-label">When</label>
            <div class="row g-2">
                <div class="col-md-6">
                    <InputDate @bind-Value="activity.When" class="form-control" />
                </div>
                <div class="col-md-6">
                    <input type="time" class="form-control" 
                           value="@activity.When.ToString("HH:mm")" 
                           @onchange="@((ChangeEventArgs e) => UpdateTime(e.Value?.ToString() ?? ""))" />
                </div>
            </div>
            <ValidationMessage For="@(() => activity.When)" />
        </div>

        <div class="mb-3">
            <label class="form-label">Amount@(selectedActivityType?.Unit != null ? $" ({selectedActivityType.Unit})" : "")</label>
            <InputNumber @bind-Value="activity.Amount" class="form-control" min="0" step="1" />
            <ValidationMessage For="@(() => activity.Amount)" />
        </div>

        <div class="mb-3">
            <label class="form-label">Duration (minutes or M:SS)</label>
            <div class="input-group">
                <InputText @bind-Value="durationInput" class="form-control" placeholder="e.g., 20 or 5:30" disabled="@_isActive" />
                <button type="button" class="btn @(_isActive ? "btn-warning" : "btn-outline-secondary")"
                        @onclick="HandleStartStop"
                        title="@(_isActive ? "Stop timer and record duration" : "Start timer")">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="me-1" viewBox="0 0 16 16">
                        <path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71V3.5z"/>
                        <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0z"/>
                    </svg>
                    @(_isActive ? "Stop" : "Start")
                </button>
            </div>
            <div class="form-text">
                Enter a whole number for minutes (e.g., <code>20</code> for 20 minutes) or <code>M:SS</code> for minutes and seconds (e.g., <code>5:30</code> for 5 minutes 30 seconds).
            </div>
            @if (!string.IsNullOrEmpty(durationError))
            {
                <div class="text-danger small">@durationError</div>
            }
        </div>

        <div class="mb-3">
            <label class="form-label">Notes</label>
            <InputTextArea @bind-Value="activity.Notes" class="form-control" rows="4" />
        </div>

        <div class="mb-3">
            <label class="form-label">Location</label>
            <div class="input-group mb-2">
                <select class="form-select" value="@_selectedLocationId" @onchange="OnLocationSelectionChanged">
                    <option value="">— No Location —</option>
                    @foreach (var loc in _knownLocations)
                    {
                        <option value="@loc.Id">@loc.Name</option>
                    }
                </select>
                <button type="button" class="btn btn-outline-secondary" @onclick="HandleLocationButtonClick">
                    @if (_selectedLocationId == null)
                    {
                        <span>+</span>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/>
                        </svg>
                    }
                </button>
                <button type="button" class="btn btn-outline-secondary" @onclick="GetLocationAsync" disabled="@_gettingLocation" title="Get Current location">
                    @if (_gettingLocation)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8 0a.5.5 0 0 1 .5.5v.518A7 7 0 0 1 14.982 7.5h.518a.5.5 0 0 1 0 1h-.518A7 7 0 0 1 8.5 14.982v.518a.5.5 0 0 1-1 0v-.518A7 7 0 0 1 1.018 8.5H.5a.5.5 0 0 1 0-1h.518A7 7 0 0 1 7.5.518V.5A.5.5 0 0 1 8 0zm0 2.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11zm0 3a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5z"/>
                        </svg>
                    }
                </button>
            </div>
            @if (!string.IsNullOrEmpty(_locationError))
            {
                <div class="text-danger small mt-1">@_locationError</div>
            }
        </div>

        <div class="mb-3">
            <button type="submit" class="btn btn-primary">@(IsEditMode ? "Update" : "Add")</button>
            <button type="button" class="btn btn-secondary ms-2" @onclick="Cancel">Cancel</button>
        </div>
    </EditForm>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Activity activity = new() { When = DateTime.Now };
    private List<ActivityType> activityTypes = new();
    private List<KnownLocation> _knownLocations = new();
    private int? _selectedLocationId;
    private ActivityType? selectedActivityType;
    private bool IsEditMode => Id > 0;
    private string durationInput = string.Empty;
    private string? durationError;
    private bool _gettingLocation;
    private string? _locationError;
    private bool _isActive;

    private int ActivityTypeId
    {
        get => activity.ActivityTypeId;
        set
        {
            activity.ActivityTypeId = value;
            UpdateSelectedActivityType();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        activityTypes = await ActivityTypeService.GetAllAsync();
        _knownLocations = (await KnownLocationService.GetAllAsync())
            .OrderBy(l => l.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (IsEditMode)
        {
            var existingActivity = await ActivityService.GetByIdAsync(Id);
            if (existingActivity != null)
            {
                activity = existingActivity;
            }
        }
        else
        {
            // Check for duplicate parameter
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            if (!string.IsNullOrEmpty(uri.Query))
            {
                var queryString = uri.Query.TrimStart('?');
                var queryParams = queryString.Split('&')
                    .Select(p => p.Split('='))
                    .Where(p => p.Length == 2)
                    .ToDictionary(p => Uri.UnescapeDataString(p[0]), p => Uri.UnescapeDataString(p[1]));

                if (queryParams.TryGetValue("duplicateFrom", out var duplicateFromValue) &&
                    int.TryParse(duplicateFromValue, out var duplicateFromId))
                {
                    var sourceActivity = await ActivityService.GetByIdAsync(duplicateFromId);
                    if (sourceActivity != null)
                    {
                        // Create a new activity with the same data but Id = 0
                        activity = new Activity
                        {
                            Id = 0,
                            ActivityTypeId = sourceActivity.ActivityTypeId,
                            When = DateTime.Now,
                            Amount = sourceActivity.Amount,
                            Notes = sourceActivity.Notes,
                            DurationSeconds = sourceActivity.DurationSeconds,
                            Latitude = sourceActivity.Latitude,
                            Longitude = sourceActivity.Longitude,
                            KnownLocationId = sourceActivity.KnownLocationId
                        };
                    }
                }
            }
        }

        _selectedLocationId = activity.KnownLocationId;
        durationInput = FormatDuration(activity.DurationSeconds);
        UpdateSelectedActivityType();
        _isActive = ActiveActivityService.IsActive(activity.Id);
        ActiveActivityService.OnChanged += OnActiveStateChanged;
    }

    private void OnActiveStateChanged()
    {
        _isActive = ActiveActivityService.IsActive(activity.Id);
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ActiveActivityService.OnChanged -= OnActiveStateChanged;
    }

    private void UpdateSelectedActivityType()
    {
        selectedActivityType = activityTypes.FirstOrDefault(t => t.Id == activity.ActivityTypeId);
        StateHasChanged();
    }

    private string GetNavigationPath(string path)
    {
        var baseUri = Navigation.BaseUri.TrimEnd('/');
        var normalizedPath = path.TrimStart('/');
        return $"{baseUri}/{normalizedPath}";
    }

    private void OnLocationSelectionChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
            _selectedLocationId = id;
        else
            _selectedLocationId = null;
    }

    private void HandleLocationButtonClick()
    {
        var returnUrl = IsEditMode ? $"/activity/{Id}" : "/activity";
        var encodedReturnUrl = Uri.EscapeDataString(returnUrl);

        if (_selectedLocationId == null)
            Navigation.NavigateTo(GetNavigationPath($"/known-location?returnUrl={encodedReturnUrl}"));
        else
            Navigation.NavigateTo(GetNavigationPath($"/known-location/{_selectedLocationId}?returnUrl={encodedReturnUrl}"));
    }

    private async Task HandleSubmit()
    {
        if (!await SaveActivityAsync())
            return;
        Navigation.NavigateTo(GetNavigationPath("/"));
    }

    private async Task HandleStartStop()
    {
        if (_isActive)
        {
            var startTime = ActiveActivityService.GetAll()[activity.Id];
            durationInput = DateTimeHelper.FormatElapsed(DateTime.Now - startTime);
            if (!await SaveActivityAsync())
                return;
            ActiveActivityService.Finish(activity.Id);
        }
        else
        {
            if (!await SaveActivityAsync())
                return;
            // Use the activity's own When as the timer start so elapsed reflects
            // time since the activity began, not since the button was pressed.
            ActiveActivityService.Start(activity.Id, activity.When);
        }
    }

    private async Task<bool> SaveActivityAsync()
    {
        if (!TryParseDurationInput(durationInput, out var durationSeconds, out var error))
        {
            durationError = error;
            return false;
        }

        durationError = null;
        activity.DurationSeconds = durationSeconds;
        activity.Notes = activity.Notes.NullIfEmptyOrWhitespace();

        activity.KnownLocationId = _selectedLocationId;
        var selectedLocation = _selectedLocationId.HasValue
            ? _knownLocations.FirstOrDefault(l => l.Id == _selectedLocationId.Value)
            : null;
        activity.Latitude = selectedLocation?.Latitude;
        activity.Longitude = selectedLocation?.Longitude;

        if (activity.Id > 0)
        {
            await ActivityService.UpdateAsync(activity);
        }
        else
        {
            activity = await ActivityService.AddAsync(activity);
        }

        return true;
    }

    private void Cancel()
    {
        Navigation.NavigateTo(GetNavigationPath("/"));
    }

    private void HandleActivityTypeButtonClick()
    {
        // Build return URL to come back to this activity form
        var returnUrl = IsEditMode
            ? $"/activity/{Id}"
            : "/activity";
        var encodedReturnUrl = Uri.EscapeDataString(returnUrl);
        
        if (activity.ActivityTypeId == 0)
        {
            // Create new activity type
            Navigation.NavigateTo(GetNavigationPath($"/activity-type?returnUrl={encodedReturnUrl}"));
        }
        else
        {
            // Edit existing activity type
            Navigation.NavigateTo(GetNavigationPath($"/activity-type/{activity.ActivityTypeId}?returnUrl={encodedReturnUrl}"));
        }
    }

    private void UpdateTime(string timeString)
    {
        if (TimeSpan.TryParse(timeString, out var time))
        {
            activity.When = activity.When.Date + time;
        }
    }

    private static string FormatDuration(int? durationSeconds)
    {
        if (!durationSeconds.HasValue || durationSeconds.Value <= 0)
        {
            return string.Empty;
        }

        var totalSeconds = durationSeconds.Value;
        var minutes = totalSeconds / 60;
        var seconds = totalSeconds % 60;
        if (minutes == 0)
        {
            // Seconds only, e.g., "0:20" so it's clear it's 20 seconds
            return $"0:{seconds:00}";
        }

        if (seconds == 0)
        {
            // Whole minutes only, e.g., "20"
            return $"{minutes}";
        }

        // Minutes and seconds, e.g., "5:30"
        return $"{minutes}:{seconds:00}";
    }

    private async Task GetLocationAsync()
    {
        _gettingLocation = true;
        _locationError = null;
        StateHasChanged();

        try
        {
            var result = await JSRuntime.InvokeAsync<LocationResult>("geolocationHelper.getLocation");
            if (result.Error != null)
            {
                _locationError = result.Error switch
                {
                    "denied" => "Location access was denied. Enable it in browser settings or enter coordinates manually.",
                    _ => "Location is unavailable on this device or browser."
                };
            }
            else if (result.Latitude.HasValue && result.Longitude.HasValue)
            {
                var nearby = await KnownLocationService.FindNearbyAsync(result.Latitude.Value, result.Longitude.Value);
                if (nearby != null)
                {
                    _selectedLocationId = nearby.Id;
                }
                else
                {
                    var name = await KnownLocationService.NextAutoNameAsync();
                    var newLocation = new KnownLocation
                    {
                        Latitude = result.Latitude.Value,
                        Longitude = result.Longitude.Value,
                        Name = name
                    };
                    var saved = await KnownLocationService.SaveAsync(newLocation);
                    _knownLocations = (await KnownLocationService.GetAllAsync())
                        .OrderBy(l => l.Name, StringComparer.OrdinalIgnoreCase)
                        .ToList();
                    _selectedLocationId = saved.Id;
                }
            }
        }
        catch
        {
            _locationError = "Unable to get location. Enter coordinates manually.";
        }
        finally
        {
            _gettingLocation = false;
        }
    }

    private sealed class LocationResult
    {
        public double? Latitude { get; set; }
        public double? Longitude { get; set; }
        public double? Accuracy { get; set; }
        public string? Error { get; set; }
    }

    private static bool TryParseDurationInput(string? input, out int? durationSeconds, out string? error)
    {
        durationSeconds = null;
        error = null;

        if (string.IsNullOrWhiteSpace(input))
        {
            return true;
        }

        input = input.Trim();
        var parts = input.Split(':');

        if (parts.Length == 1)
        {
            // Single integer = minutes, e.g., "20" means 20 minutes
            if (!int.TryParse(parts[0], out var minutesOnly))
            {
                error = "Duration must be a number of minutes or in M:SS format.";
                return false;
            }

            if (minutesOnly < 0)
            {
                error = "Duration cannot be negative.";
                return false;
            }

            if (minutesOnly > 999)
            {
                error = "Minutes must be less than 1000.";
                return false;
            }

            durationSeconds = minutesOnly * 60;
            return true;
        }

        if (parts.Length != 2)
        {
            error = "Duration must be a number of minutes (e.g., 20) or in M:SS format (e.g., 5:30).";
            return false;
        }

        if (!int.TryParse(parts[0], out var minutes) || !int.TryParse(parts[1], out var seconds))
        {
            error = "Minutes and seconds must be numeric.";
            return false;
        }

        if (minutes < 0 || seconds < 0)
        {
            error = "Duration cannot be negative.";
            return false;
        }

        if (seconds >= 60)
        {
            error = "Seconds must be between 00 and 59.";
            return false;
        }

        if (minutes > 999)
        {
            error = "Minutes must be less than 1000.";
            return false;
        }

        durationSeconds = (minutes * 60) + seconds;
        return true;
    }
}

