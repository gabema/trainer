@inject IActiveActivityService ActiveActivityService
@inject IActivityService ActivityService
@inject IActivityTypeService ActivityTypeService
@inject IJSRuntime JSRuntime
@implements IDisposable

@* Headless component — renders no HTML. Bridges IActiveActivityService events to browser notifications. *@

@code {
    private readonly Dictionary<int, string> _typeNames = new();

    protected override async Task OnInitializedAsync()
    {
        // Subscribe before initialising so restored state raises events into live handlers
        ActiveActivityService.OnChanged += OnChanged;
        ActiveActivityService.OnSlowTick += OnSlowTick;

        // Load persisted active activities from localStorage
        await ActiveActivityService.InitializeAsync();

        // Request notification permission once on mount
        try
        {
            await JSRuntime.InvokeAsync<object>("notificationHelper.requestPermission");
        }
        catch
        {
            // Permission API unavailable — notifications will be silently skipped
        }
    }

    private void OnChanged() => InvokeAsync(HandleChangedAsync);
    private void OnSlowTick() => InvokeAsync(HandleSlowTickAsync);

    private async Task HandleChangedAsync()
    {
        var types = await ActivityTypeService.GetAllAsync();
        var activeIds = ActiveActivityService.GetAll().Keys.ToList();

        // Close notifications for activities that are no longer active
        var stale = _typeNames.Keys.Except(activeIds).ToList();
        foreach (var id in stale)
        {
            await CloseNotificationAsync(id);
            _typeNames.Remove(id);
        }

        // Show notifications for newly active activities
        foreach (var activityId in activeIds)
        {
            if (!_typeNames.ContainsKey(activityId))
            {
                var name = await ResolveTypeNameAsync(activityId, types);
                _typeNames[activityId] = name;
                var elapsed = DateTimeHelper.FormatElapsed(
                    DateTime.Now - ActiveActivityService.GetAll()[activityId]);
                await ShowNotificationAsync(activityId, name, elapsed);
            }
        }
    }

    private async Task HandleSlowTickAsync()
    {
        foreach (var (activityId, startTime) in ActiveActivityService.GetAll())
        {
            var name = _typeNames.TryGetValue(activityId, out var n) ? n : "Activity";
            var elapsed = DateTimeHelper.FormatElapsed(DateTime.Now - startTime);
            await UpdateNotificationAsync(activityId, name, elapsed);
        }
    }

    private async Task<string> ResolveTypeNameAsync(int activityId, List<ActivityType> types)
    {
        var activity = await ActivityService.GetByIdAsync(activityId);
        if (activity == null) return "Activity";
        return types.FirstOrDefault(t => t.Id == activity.ActivityTypeId)?.Name ?? "Activity";
    }

    private async Task ShowNotificationAsync(int activityId, string name, string elapsed)
    {
        try { await JSRuntime.InvokeVoidAsync("notificationHelper.startActiveNotification", activityId, name, elapsed); }
        catch { /* notification unavailable */ }
    }

    private async Task UpdateNotificationAsync(int activityId, string name, string elapsed)
    {
        try { await JSRuntime.InvokeVoidAsync("notificationHelper.updateActiveNotification", activityId, name, elapsed); }
        catch { /* notification unavailable */ }
    }

    private async Task CloseNotificationAsync(int activityId)
    {
        try { await JSRuntime.InvokeVoidAsync("notificationHelper.closeActiveNotification", activityId); }
        catch { /* notification unavailable */ }
    }

    public void Dispose()
    {
        ActiveActivityService.OnChanged -= OnChanged;
        ActiveActivityService.OnSlowTick -= OnSlowTick;
    }
}
