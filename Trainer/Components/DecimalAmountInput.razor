@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<input @ref="_element" type="text" inputmode="numeric" class="@CssClass"
       placeholder="@Placeholder" disabled="@Disabled" />

@code {
    [Parameter] public int? Value { get; set; }
    [Parameter] public EventCallback<int?> ValueChanged { get; set; }

    /// <summary>Number of decimal places to display/enter. 0 = whole numbers (identical to a plain integer field).</summary>
    [Parameter] public int DecimalPlaces { get; set; }

    [Parameter] public string CssClass { get; set; } = "form-control";
    [Parameter] public bool Disabled { get; set; }

    private ElementReference _element;
    private DotNetObjectReference<DecimalAmountInput>? _ref;
    private bool _attached;
    private int? _lastValue;
    private int _lastPlaces = -1;

    // Shown when the field is empty so the precision is still visible (e.g. "0.00").
    private string Placeholder => DecimalAmount.Format(0, DecimalPlaces);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ref = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("decimalInput.attach", _element, _ref, DecimalPlaces, Value);
            _attached = true;
            _lastValue = Value;
            _lastPlaces = DecimalPlaces;
        }
        else if (_attached && (Value != _lastValue || DecimalPlaces != _lastPlaces))
        {
            // Value or precision changed from outside (type switched, activity loaded for edit).
            await JSRuntime.InvokeVoidAsync("decimalInput.sync", _element, DecimalPlaces, Value);
            _lastValue = Value;
            _lastPlaces = DecimalPlaces;
        }
    }

    [JSInvokable]
    public async Task OnInput(int? value)
    {
        Value = value;
        // Record what JS already shows so the next render doesn't re-sync and move the caret.
        _lastValue = value;
        await ValueChanged.InvokeAsync(value);
    }

    public async ValueTask DisposeAsync()
    {
        if (_ref is not null)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("decimalInput.detach", _element);
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone during teardown; nothing to detach.
            }

            _ref.Dispose();
        }
    }
}
