@inject IActiveActivityService ActiveActivityService
@inject IActivityService ActivityService
@inject IActivityTypeService ActivityTypeService
@implements IDisposable

@if (ActiveActivityService.GetAll().Any())
{
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card border-warning">
                <div class="card-header active-activities-header">
                    <h5 class="mb-0">Active Activities</h5>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @foreach (var (activityId, startTime) in ActiveActivityService.GetAll())
                        {
                            var typeName = GetTypeName(activityId);
                            if (string.IsNullOrEmpty(typeName)) continue;
                            var elapsedSeconds = (int)(DateTime.Now - startTime).TotalSeconds;
                            var elapsed = ActivityAmountDisplay.FormatDuration(elapsedSeconds) ?? "0s";
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>
                                    <strong>@typeName</strong>
                                    <span class="ms-2 text-muted font-monospace">@elapsed</span>
                                </span>
                                <button class="btn btn-sm btn-success" @onclick="() => FinishActivityAsync(activityId)">Finish</button>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private readonly Dictionary<int, string> _typeNames = new();

    protected override void OnInitialized()
    {
        ActiveActivityService.OnChanged += OnActiveChanged;
        ActiveActivityService.OnTick += OnTick;
    }

    protected override async Task OnInitializedAsync()
    {
        await ResolveTypeNamesAsync();
    }

    // Resolve names for any newly active activities then redraw
    private void OnActiveChanged() => InvokeAsync(async () =>
    {
        await ResolveTypeNamesAsync();
        StateHasChanged();
    });

    private void OnTick() => InvokeAsync(StateHasChanged);

    private string GetTypeName(int activityId) =>
        _typeNames.TryGetValue(activityId, out var n) ? n : string.Empty;

    private async Task ResolveTypeNamesAsync()
    {
        var activeIds = ActiveActivityService.GetAll().Keys.ToList();
        if (activeIds.Count == 0) return;

        // Fetch types fresh each call — avoids stale-parameter timing issues
        var types = await ActivityTypeService.GetAllAsync();

        foreach (var activityId in activeIds)
        {
            if (_typeNames.ContainsKey(activityId)) continue;
            var activity = await ActivityService.GetByIdAsync(activityId);
            if (activity == null) continue;
            var name = types.FirstOrDefault(t => t.Id == activity.ActivityTypeId)?.Name;
            // Only cache when we have a real name — lets us retry if types weren't loaded yet
            if (!string.IsNullOrEmpty(name))
                _typeNames[activityId] = name;
        }
    }

    private async Task FinishActivityAsync(int activityId)
    {
        if (!ActiveActivityService.GetAll().TryGetValue(activityId, out var startTime))
            return;

        var elapsed = DateTime.Now - startTime;
        var activity = await ActivityService.GetByIdAsync(activityId);
        if (activity != null)
        {
            activity.DurationSeconds = (int)elapsed.TotalSeconds;
            await ActivityService.UpdateAsync(activity);
        }

        ActiveActivityService.Finish(activityId);
        _typeNames.Remove(activityId);
    }

    public void Dispose()
    {
        ActiveActivityService.OnChanged -= OnActiveChanged;
        ActiveActivityService.OnTick -= OnTick;
    }
}
